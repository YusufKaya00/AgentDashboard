# Optional overrides. Standard runtime homes are discovered from the current user automatically.
HOST=127.0.0.1
PORT=8000
ENABLE_RUNTIME_LIVE_UPDATES=true
RUNTIME_SESSION_SCOPE=all

# Set this only when the managed project is not the dashboard checkout.
# WORKSPACE_DIR=C:\path\to\project

# Optional non-standard runtime homes.
# DASHBOARD_HOME_DIR=C:\Users\you
# CODEX_HOME=C:\Users\you\.codex
# CODEX_SQLITE_HOME=C:\Users\you\.codex
# CLAUDE_CONFIG_DIR=C:\Users\you\.claude
# GEMINI_HOME=C:\Users\you\.gemini

# Optional runtime hook CLI overrides.
# DASHBOARD_CODEX_COMMAND=C:\path\to\codex.exe
# DASHBOARD_CLAUDE_COMMAND=C:\path\to\claude.exe
# DASHBOARD_ANTIGRAVITY_COMMAND=C:\path\to\antigravity.exe
